# ============================================================
# KernelLens .gitignore
# ============================================================

# --- Rust ---
/target/
**/*.rs.bk
# Note: Cargo.lock is tracked for binaries/applications to ensure reproducible builds.
# For pure libraries, it should be ignored. This project contains CLI tools, so we track it.

# --- Flutter/Dart ---
app/.dart_tool/
app/.packages
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/pubspec.lock
app/windows/flutter/ephemeral/

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Test Artifacts ---
*.img
*.lz4
*.elf
!crates/test_utils/fixtures/*.img

# --- Build Artifacts ---
*.dll
*.so
*.dylib
*.exe
!target/release/*.exe

# --- Logs ---
*.log
*.trace

# --- Secrets ---
.env
.env.local
